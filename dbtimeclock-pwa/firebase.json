{
  "hosting": [
    {
      "site": "db-crews",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/config.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "predeploy": [
        "node ./check-config.mjs"
      ]
    },
    {
      "site": "db-time-clock",
      "public": "redirect",
      "redirects": [
        {
          "source": "**",
          "destination": "https://db-crews.web.app",
          "type": 301
        }
      ]
    }
  ]
}
