{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/data/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Barlow|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Barlow, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|href|status|selected|openLabel|key|ref|className|style|children)$/]",
        "message": "<AppTile> doesn't accept that prop. Declared props: icon, title, description, href, status, selected, openLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTile'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:live|in-build|planned)$/]",
        "message": "<AppTile> status must be one of 'live' | 'in-build' | 'planned'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|shape|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, variant, shape, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|navy|neutral|warm|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'green' | 'navy' | 'neutral' | 'warm' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid|outline|on-dark)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid' | 'outline' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|pill)$/]",
        "message": "<Badge> shape must be one of 'square' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|uppercase|fullWidth|disabled|iconLeft|iconRight|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, uppercase, fullWidth, disabled, iconLeft, iconRight, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|outline|ghost|on-dark|mono)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'outline' | 'ghost' | 'on-dark' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|tone|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: lead, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warning|info|live|neutral)$/]",
        "message": "<Callout> tone must be one of 'warning' | 'info' | 'live' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevation|accentTop|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevation, accentTop, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|sm|md|lg)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|numeric|align|width|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, numeric, align, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|label|disabled|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, label, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|ghost)$/]",
        "message": "<IconButton> variant must be one of 'solid' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|as|rows|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, as, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiBannerColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|caption|tone|key|ref|className|style|children)$/]",
        "message": "<KpiBannerColumn> doesn't accept that prop. Declared props: label, value, caption, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiBannerColumn'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<KpiBannerColumn> tone must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|tone|padding|children|key|ref|className|style|children)$/]",
        "message": "<MetricStrip> doesn't accept that prop. Declared props: title, meta, tone, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricStrip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|navy)$/]",
        "message": "<MetricStrip> tone must be one of 'ink' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|number|as|children|key|ref|className|style|children)$/]",
        "message": "<MonoLabel> doesn't accept that prop. Declared props: tone, size, number, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|accent|accent-dark|strong)$/]",
        "message": "<MonoLabel> tone must be one of 'light' | 'dark' | 'accent' | 'accent-dark' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<MonoLabel> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|meta|actions|key|ref|className|style|children)$/]",
        "message": "<PanelHeader> doesn't accept that prop. Declared props: number, title, meta, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|align|inverse|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, description, align, inverse."
